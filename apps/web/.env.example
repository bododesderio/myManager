# ── myManager web (Next.js) environment ──────────────────────────────────────
# Copy to .env.local and fill in. Only NEXT_PUBLIC_* values reach the browser.

# Base URL of the NestJS API (used by the axios apiClient).
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Public base URL of this web app.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Flutterwave public (publishable) key for the checkout widget.
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=""

# ── CKEditor 5 rich-text editor ──────────────────────────────────────────────
# The editor works for FREE with no value here — it falls back to the
# open-source 'GPL' key automatically (no account, no purchase, no limits).
#
# Only set this if you later buy a CKEditor commercial license, or get a free
# cloud key at https://portal.ckeditor.com. Paste it below and rebuild the web
# app (npm run build); it overrides the free default. See lib/config/editor.ts.
NEXT_PUBLIC_CKEDITOR_LICENSE_KEY=""

# ── NextAuth / Auth.js (server-side, NOT public) ─────────────────────────────
# NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_SECRET=""   # generate: openssl rand -base64 32
# AUTH_SECRET=""       # same value as NEXTAUTH_SECRET
# API_URL="http://localhost:3001"
